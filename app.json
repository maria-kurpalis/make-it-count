{
  "expo": {
    "name": "Momentum Daily",
    "slug": "momentum-daily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mariak.momentumdaily"
    },
    "android": {
      "package": "com.mariak.momentumdaily",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
